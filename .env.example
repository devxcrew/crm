# Runtime
NODE_ENV=development
# India Standard Time (UTC+05:30)
TZ=Asia/Kolkata
AUTH_MODE=jwt
DEV_AUTO_LOGIN=0

# CRM Platform API and Web
APP_BRAND_NAME="Client CRM"
MOBILE_APP_BRAND_NAME="Client CRM"
APP_BRAND_TAGLINE="Client CRM workspace"
PLATFORM_API_PORT=7050
PLATFORM_API_URL=http://127.0.0.1:7050
PLATFORM_WEB_PORT=7060
PLATFORM_WEB_ORIGIN=http://127.0.0.1:7060
PLATFORM_WEB_ORIGINS=https://crm.example.com,http://localhost
PLATFORM_WEB_HEALTH_URL=http://127.0.0.1:7060/status
VITE_PLATFORM_API_URL=http://127.0.0.1:7050
VITE_MOBILE_API_URL=http://127.0.0.1:7050
VITE_DEV_AUTO_LOGIN=0

# Mobile build profile. Set these separately for every client deployment.
MOBILE_API_URL=https://crm.example.com/api/platform
MOBILE_RELEASE_BASE_URL=https://crm.example.com/mobile/update
MOBILE_RELEASE_MANIFEST_URL=https://crm.example.com/mobile/update/latest.json
ANDROID_APPLICATION_ID=com.example.clientcrm
MOBILE_RELEASE_FILE_PREFIX=client-crm
MOBILE_LOGO_ASSET=assets/crm-logo.png
MOBILE_ANDROID_BRAND_ASSET=crm

# Local development database.
# Container setup replaces these three values in .container/.env from deploy.env.
DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=techmedia
DB_PASSWORD=
DB_NAME=techmedia_db

# Messaging attachment storage. This local folder is replaced by the R2 adapter later.
MESSAGE_MEDIA_STORAGE_ROOT=./storage/messaging
MESSAGE_MEDIA_MAX_UPLOAD_BYTES=10485760
MOBILE_RELEASE_STORAGE_ROOT=./storage/mobile/release

# Authentication and protected administrator
JWT_SECRET=
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_EMAIL=admin@admin.com
INITIAL_ADMIN_PASSWORD=

# Optional dedicated Frappe credential encryption key.
# When empty, CRM derives credential encryption from JWT_SECRET.
TECHMEDIA_INTEGRATION_ENCRYPTION_KEY=

# Live Frappe connection
# Container deployment overrides this with the mounted root .env path.
TECHMEDIA_ENV_FILE_PATH=
FRAPPE_ENABLED=1
FRAPPE_CONNECTION_NAME=Frappe
FRAPPE_BASE_URL=
FRAPPE_APP_KEY=
FRAPPE_APP_SECRET=
FRAPPE_LAST_CHECKED_AT=
FRAPPE_LAST_VERIFIED_AT=
FRAPPE_UPDATED_AT=
FRAPPE_VERIFICATION_STATUS=unverified

# Destructive database reset remains disabled
TECHMEDIA_DB_FRESH_ON_START=0
TECHMEDIA_DB_RESET_CONFIRM=
TECHMEDIA_ALLOW_PRODUCTION_DB_RESET=0
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6-terra
AI_TIMEOUT_MS=120000
